<IfModule mod_headers.c>
    # Prevenir que la página sea embebida en un iframe (Anti-Clickjacking)
    Header set X-Frame-Options "DENY"

    # Prevenir que el navegador intente adivinar el tipo MIME (Anti-MIME sniffing)
    Header set X-Content-Type-Options "nosniff"

    # Política de Referrer estricta para proteger privacidad de navegación
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Restricción de permisos de APIs del navegador no requeridas
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Content Security Policy (CSP) adaptada a Firebase, Tailwind CDN y Google Fonts
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://*.firebase.com https://*.cloudfunctions.net; frame-ancestors 'none';"
</IfModule>

# Proteger archivos sensibles de configuración contra acceso directo HTTP
<FilesMatch "^(\.gitignore|\.env|firestore\.rules|firebase\.json|firebase-credenciales\.js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
